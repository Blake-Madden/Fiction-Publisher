{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "bookFolder",
            "type": "promptString",
            "description": "Book project folder"
        }
    ],
    "tasks": [
        {
            "label": "Build Book",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/Build.ps1", "-BookFolder", "${input:bookFolder}"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "revealProblems": "onProblem", "panel": "dedicated", "clear": true },
            "problemMatcher": {
                "owner": "fiction-publisher",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "severity": "warning",
                "pattern": {
                    "regexp": "^(.+)\\((\\d+)\\): (warning|error): (.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Configure Book",
            "type": "shell",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/Config.ps1", "-BookFolder", "${input:bookFolder}"],
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Open Format Warnings Log",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile", "-Command",
                "$cli = Get-Command codium, code -ErrorAction SilentlyContinue | Select-Object -First 1; if (-not $cli) { Write-Error 'Neither codium nor code was found on PATH.'; exit 1 }; Get-ChildItem -LiteralPath (Join-Path $env:FP_BOOK 'Fiction-Publisher-Output') -Filter '*Format Warnings.log' -ErrorAction SilentlyContinue | ForEach-Object { & $cli.Source -r $_.FullName }"
            ],
            "options": { "env": { "FP_BOOK": "${input:bookFolder}" } },
            "presentation": { "reveal": "silent" },
            "problemMatcher": []
        }
    ]
}
